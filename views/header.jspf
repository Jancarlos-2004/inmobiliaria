<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:if test="${not empty tituloPagina}">${tituloPagina} - </c:if>Nexus Living Co</title>
    <meta name="description" content="Nexus Living Co — Compra, venta y arriendo de propiedades en Santander. Encuentra tu próximo inmueble con nosotros.">
    <link rel="icon" type="image/png" href="${pageContext.request.contextPath}/assets/img/favicon.png">
    <!-- Bootstrap 5 Framework (Requisito Oficial del Parcial) -->
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/estilos.css">
    <script>
        // Aplicar tema guardado ANTES del render para evitar flash
        try {
            var t = localStorage.getItem("nexus-tema");
            if (t === "oscuro") document.documentElement.setAttribute("data-tema", "oscuro");
        } catch(e){}
    </script>
</head>
<body>

<%-- Overlay y panel lateral del menú móvil --%>
<div class="menu-movil-overlay" id="menuMovilOverlay" aria-hidden="true"></div>
<nav class="menu-movil" id="menuMovil" aria-label="Navegación principal" role="dialog" aria-modal="true">
    <div class="menu-movil-cabecera">
        <a class="logo" href="${pageContext.request.contextPath}/index.jsp">
            <img src="${pageContext.request.contextPath}/assets/img/logo.svg" alt="Nexus Living Co" class="logo-img" style="height:30px;">
            <span>Nexus Living Co</span>
        </a>
        <button type="button" class="menu-movil-cerrar" aria-label="Cerrar menú">
            <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
    </div>
    <div class="menu-movil-cuerpo">
        <div class="menu-movil-nav">
            <c:if test="${not empty sessionScope.usuario}">
                <div class="menu-movil-usuario">
                    <div class="menu-movil-usuario-nombre">${sessionScope.usuario.perfil.nombres} ${sessionScope.usuario.perfil.apellidos}</div>
                    <div class="menu-movil-usuario-correo">${sessionScope.usuario.correo}</div>
                </div>
            </c:if>

            <a href="${pageContext.request.contextPath}/index.jsp">
                <svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg>
                Inicio
            </a>
            <a href="${pageContext.request.contextPath}/buscar">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                Buscar propiedades
            </a>

            <c:choose>
                <c:when test="${not empty sessionScope.usuario}">
                    <div class="menu-movil-separador"></div>
                    <c:if test="${sessionScope.usuario.tieneRol('Cliente')}">
                        <div class="menu-movil-seccion-titulo">Panel cliente</div>
                        <a href="${pageContext.request.contextPath}/dashboard_cliente.jsp">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                            Mi panel
                        </a>
                        <a href="${pageContext.request.contextPath}/cliente/citas">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                            Mis citas
                        </a>
                        <a href="${pageContext.request.contextPath}/cliente/solicitudes">
                            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Mis solicitudes
                        </a>
                    </c:if>
                    <c:if test="${sessionScope.usuario.tieneRol('Inmobiliaria')}">
                        <div class="menu-movil-seccion-titulo">Panel agente</div>
                        <a href="${pageContext.request.contextPath}/dashboard_agente.jsp">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                            Panel agente
                        </a>
                        <a href="${pageContext.request.contextPath}/agente/propiedades">
                            <svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
                            Mis propiedades
                        </a>
                        <a href="${pageContext.request.contextPath}/agente/citas">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                            Citas
                        </a>
                        <a href="${pageContext.request.contextPath}/agente/solicitudes">
                            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Solicitudes
                        </a>
                    </c:if>
                    <c:if test="${sessionScope.usuario.tieneRol('Administrador')}">
                        <div class="menu-movil-seccion-titulo">Administración</div>
                        <a href="${pageContext.request.contextPath}/dashboard_admin.jsp">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                            Panel admin
                        </a>
                        <a href="${pageContext.request.contextPath}/admin/usuarios">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            Usuarios
                        </a>
                        <a href="${pageContext.request.contextPath}/admin/auditoria">Auditoría</a>
                        <a href="${pageContext.request.contextPath}/admin/reportes">Reportes</a>
                    </c:if>
                    <div class="menu-movil-separador"></div>
                    <a href="${pageContext.request.contextPath}/perfil">
                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Mi perfil
                    </a>
                    <a href="${pageContext.request.contextPath}/logout" style="color:var(--color-error);">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        Cerrar sesión
                    </a>
                </c:when>
                <c:otherwise>
                    <div class="menu-movil-separador"></div>
                    <a href="${pageContext.request.contextPath}/login.jsp">
                        <svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                        Iniciar sesión
                    </a>
                    <a href="${pageContext.request.contextPath}/registro.jsp" class="boton-registro">
                        Registrarme
                    </a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</nav>

<header class="cabecera" role="banner">
    <div class="cabecera-contenido">
        <a class="logo" href="${pageContext.request.contextPath}/index.jsp">
            <img src="${pageContext.request.contextPath}/assets/img/logo.svg" alt="Nexus Living Co" class="logo-img">
            <span>Nexus Living Co</span>
        </a>

        <%-- Navegación principal escritorio --%>
        <nav class="menu" aria-label="Navegación principal">
            <a href="${pageContext.request.contextPath}/index.jsp">Inicio</a>
            <a href="${pageContext.request.contextPath}/buscar">Buscar</a>

            <c:choose>
                <c:when test="${not empty sessionScope.usuario}">
                    <c:if test="${sessionScope.usuario.tieneRol('Cliente')}">
                        <a href="${pageContext.request.contextPath}/dashboard_cliente.jsp">Mi panel</a>
                        <a href="${pageContext.request.contextPath}/cliente/citas">Mis citas</a>
                        <a href="${pageContext.request.contextPath}/cliente/solicitudes">Mis solicitudes</a>
                    </c:if>
                    <c:if test="${sessionScope.usuario.tieneRol('Inmobiliaria')}">
                        <a href="${pageContext.request.contextPath}/dashboard_agente.jsp">Panel agente</a>
                        <a href="${pageContext.request.contextPath}/agente/propiedades">Propiedades</a>
                        <a href="${pageContext.request.contextPath}/agente/citas">Citas</a>
                        <a href="${pageContext.request.contextPath}/agente/solicitudes">Solicitudes</a>
                    </c:if>
                    <c:if test="${sessionScope.usuario.tieneRol('Administrador')}">
                        <a href="${pageContext.request.contextPath}/dashboard_admin.jsp">Panel admin</a>
                        <a href="${pageContext.request.contextPath}/admin/usuarios">Usuarios</a>
                        <a href="${pageContext.request.contextPath}/admin/auditoria">Auditoría</a>
                        <a href="${pageContext.request.contextPath}/admin/reportes">Reportes</a>
                        <a href="${pageContext.request.contextPath}/agente/propiedades">Propiedades</a>
                        <a href="${pageContext.request.contextPath}/cambiarModo.jsp">BD: local/remota</a>
                    </c:if>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/login.jsp">Iniciar sesión</a>
                    <a href="${pageContext.request.contextPath}/registro.jsp" class="boton-registro">Registrarme</a>
                </c:otherwise>
            </c:choose>
        </nav>

        <%-- Controles de cabecera derecha --%>
        <div class="cabecera-derecha">
            <%-- Toggle modo oscuro --%>
            <button type="button" class="boton-modo" id="btnModo" aria-label="Activar modo oscuro" title="Cambiar tema">
                <svg class="icono-luna" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="icono-sol" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            </button>

            <%-- Dropdown de usuario (solo desktop) --%>
            <c:if test="${not empty sessionScope.usuario}">
                <div class="usuario-dropdown" id="usuarioDropdown">
                    <button type="button" class="usuario-dropdown-btn" aria-haspopup="true" aria-expanded="false">
                        <span class="usuario-avatar" aria-hidden="true">
                            ${fn:substring(sessionScope.usuario.perfil.nombres, 0, 1)}
                        </span>
                        ${sessionScope.usuario.perfil.nombres}
                        <svg class="usuario-dropdown-caret" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="usuario-dropdown-menu" role="menu">
                        <div class="usuario-dropdown-info">
                            <div class="usuario-dropdown-nombre">${sessionScope.usuario.perfil.nombres} ${sessionScope.usuario.perfil.apellidos}</div>
                            <div class="usuario-dropdown-correo">${sessionScope.usuario.correo}</div>
                        </div>
                        <a href="${pageContext.request.contextPath}/perfil" role="menuitem">
                            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            Mi perfil
                        </a>
                        <c:if test="${sessionScope.usuario.tieneRol('Cliente')}">
                            <a href="${pageContext.request.contextPath}/dashboard_cliente.jsp" role="menuitem">
                                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                                Mi panel
                            </a>
                        </c:if>
                        <c:if test="${sessionScope.usuario.tieneRol('Inmobiliaria')}">
                            <a href="${pageContext.request.contextPath}/dashboard_agente.jsp" role="menuitem">
                                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                                Panel agente
                            </a>
                        </c:if>
                        <c:if test="${sessionScope.usuario.tieneRol('Administrador')}">
                            <a href="${pageContext.request.contextPath}/dashboard_admin.jsp" role="menuitem">
                                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                                Panel admin
                            </a>
                        </c:if>
                        <div class="usuario-dropdown-separador"></div>
                        <a href="${pageContext.request.contextPath}/logout" class="usuario-dropdown-salir" role="menuitem">
                            <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            Cerrar sesión
                        </a>
                    </div>
                </div>
            </c:if>

            <%-- Hamburguesa (solo móvil, visible via CSS) --%>
            <button type="button" class="menu-hamburguesa" id="btnHamburguesa" aria-label="Abrir menú" aria-expanded="false" aria-controls="menuMovil">
                <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
        </div>
    </div>
</header>
<main class="contenido-principal">
