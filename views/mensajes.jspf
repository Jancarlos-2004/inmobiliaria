<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:if test="${(not empty mensajeError or not empty requestScope.mensajeError) or (not empty mensajeExito or not empty requestScope.mensajeExito)}">
<div class="contenedor-toasts" aria-live="polite" aria-atomic="true">
    <c:if test="${not empty mensajeError or not empty requestScope.mensajeError}">
        <div class="alerta alerta-error toast" role="alert">
            <span class="alerta-icono">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16h.01"/></svg>
            </span>
            <span class="alerta-texto">${empty mensajeError ? requestScope.mensajeError : mensajeError}</span>
            <button type="button" class="toast-cerrar" aria-label="Cerrar mensaje" onclick="this.closest('.alerta').remove()">&times;</button>
        </div>
    </c:if>
    <c:if test="${not empty mensajeExito or not empty requestScope.mensajeExito}">
        <div class="alerta alerta-exito toast" role="status">
            <span class="alerta-icono">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 5-5.5"/></svg>
            </span>
            <span class="alerta-texto">${empty mensajeExito ? requestScope.mensajeExito : mensajeExito}</span>
            <button type="button" class="toast-cerrar" aria-label="Cerrar mensaje" onclick="this.closest('.alerta').remove()">&times;</button>
        </div>
    </c:if>
</div>
</c:if>
