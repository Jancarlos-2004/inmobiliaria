    </main>

    <footer class="pie-pagina-rico" role="contentinfo">
        <div class="pie-pagina-contenido">
            <%-- Columna 1: Logo + descripción + redes --%>
            <div class="pie-col-logo">
                <a class="pie-logo-enlace" href="${pageContext.request.contextPath}/index.jsp">
                    <img src="${pageContext.request.contextPath}/assets/img/logo.svg" alt="Nexus Living Co" class="pie-logo-img">
                    <span>Nexus Living Co</span>
                </a>
                <p class="pie-descripcion">
                    Tu aliado de confianza en el mercado inmobiliario de Santander.
                    Compra, vende y arrienda con asesoría especializada y personalizada.
                </p>
                <div class="pie-redes" aria-label="Redes sociales">
                    <a href="#" class="pie-red" aria-label="Facebook" title="Facebook">
                        <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                    <a href="#" class="pie-red" aria-label="Instagram" title="Instagram">
                        <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    </a>
                    <a href="#" class="pie-red" aria-label="WhatsApp" title="WhatsApp">
                        <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    </a>
                    <a href="#" class="pie-red" aria-label="LinkedIn" title="LinkedIn">
                        <svg viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                </div>
            </div>

            <%-- Columna 2: Navegación --%>
            <div>
                <p class="pie-col-titulo">Navegación</p>
                <ul class="pie-nav">
                    <li><a href="${pageContext.request.contextPath}/index.jsp">Inicio</a></li>
                    <li><a href="${pageContext.request.contextPath}/buscar">Todas las propiedades</a></li>
                    <li><a href="${pageContext.request.contextPath}/login.jsp">Iniciar sesión</a></li>
                    <li><a href="${pageContext.request.contextPath}/registro.jsp">Crear cuenta</a></li>
                </ul>
            </div>

            <%-- Columna 3: Tipos de búsqueda --%>
            <div>
                <p class="pie-col-titulo">Buscar por tipo</p>
                <ul class="pie-nav">
                    <li><a href="${pageContext.request.contextPath}/buscar?q=casa">Casas</a></li>
                    <li><a href="${pageContext.request.contextPath}/buscar?q=apartamento">Apartamentos</a></li>
                    <li><a href="${pageContext.request.contextPath}/buscar?q=local">Locales comerciales</a></li>
                    <li><a href="${pageContext.request.contextPath}/buscar?q=lote">Lotes y terrenos</a></li>
                    <li><a href="${pageContext.request.contextPath}/buscar?q=oficina">Oficinas</a></li>
                </ul>
            </div>

            <%-- Columna 4: Contacto --%>
            <div>
                <p class="pie-col-titulo">Contacto</p>
                <div class="pie-contacto">
                    <div class="pie-contacto-item">
                        <svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></svg>
                        Bucaramanga, Santander, Colombia
                    </div>
                    <div class="pie-contacto-item">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.09h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.69a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        +57 (7) 000-0000
                    </div>
                    <div class="pie-contacto-item">
                        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        contacto@nexuslivingco.com
                    </div>
                    <div class="pie-contacto-item">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Lunes a Viernes 8am – 6pm
                    </div>
                </div>
            </div>
        </div>

        <div class="pie-bottom-bar">
            <span>&copy; <%= java.time.Year.now() %> Nexus Living Co. Proyecto académico.</span>
            <span class="pie-badge">
                <svg viewBox="0 0 24 24" style="width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;"><path d="M20 6L9 17l-5-5"/></svg>
                Propiedades verificadas
            </span>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS (Requisito Oficial del Parcial) -->
    <script src="${pageContext.request.contextPath}/assets/js/bootstrap.bundle.min.js"></script>
    <script src="${pageContext.request.contextPath}/assets/js/scripts.js"></script>
</body>
</html>
