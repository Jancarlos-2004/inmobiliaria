<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Nexus Living Co</display-name>

    <!-- Pagina de bienvenida -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ===================================================== -->
    <!-- SERVLET: AutenticacionController                      -->
    <!-- Atiende login, registro y logout desde una sola clase -->
    <!-- ===================================================== -->
    <servlet>
        <servlet-name>AutenticacionController</servlet-name>
        <servlet-class>controlador.AutenticacionController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AutenticacionController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AutenticacionController</servlet-name>
        <url-pattern>/registro</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AutenticacionController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AutenticacionController</servlet-name>
        <url-pattern>/perfil</url-pattern>
    </servlet-mapping>

    <!-- ===================================================== -->
    <!-- SERVLET: PropiedadController                          -->
    <!-- Busqueda publica, detalle, CRUD del agente y favoritos -->
    <!-- ===================================================== -->
    <servlet>
        <servlet-name>PropiedadController</servlet-name>
        <servlet-class>controlador.PropiedadController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PropiedadController</servlet-name>
        <url-pattern>/buscar</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PropiedadController</servlet-name>
        <url-pattern>/propiedad</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PropiedadController</servlet-name>
        <url-pattern>/favoritos/toggle</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PropiedadController</servlet-name>
        <url-pattern>/agente/propiedades</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PropiedadController</servlet-name>
        <url-pattern>/agente/propiedades/nueva</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PropiedadController</servlet-name>
        <url-pattern>/agente/propiedades/editar</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PropiedadController</servlet-name>
        <url-pattern>/agente/propiedades/baja</url-pattern>
    </servlet-mapping>

    <!-- ===================================================== -->
    <!-- SERVLET: CitaController                                -->
    <!-- ===================================================== -->
    <servlet>
        <servlet-name>CitaController</servlet-name>
        <servlet-class>controlador.CitaController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CitaController</servlet-name>
        <url-pattern>/cliente/citas</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CitaController</servlet-name>
        <url-pattern>/cliente/citas/nueva</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CitaController</servlet-name>
        <url-pattern>/agente/citas</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CitaController</servlet-name>
        <url-pattern>/agente/citas/estado</url-pattern>
    </servlet-mapping>

    <!-- ===================================================== -->
    <!-- SERVLET: SolicitudController                           -->
    <!-- ===================================================== -->
    <servlet>
        <servlet-name>SolicitudController</servlet-name>
        <servlet-class>controlador.SolicitudController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SolicitudController</servlet-name>
        <url-pattern>/cliente/solicitudes</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SolicitudController</servlet-name>
        <url-pattern>/cliente/solicitudes/nueva</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SolicitudController</servlet-name>
        <url-pattern>/agente/solicitudes</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SolicitudController</servlet-name>
        <url-pattern>/agente/solicitudes/resolver</url-pattern>
    </servlet-mapping>

    <!-- ===================================================== -->
    <!-- SERVLET: AdminController                               -->
    <!-- ===================================================== -->
    <servlet>
        <servlet-name>AdminController</servlet-name>
        <servlet-class>controlador.AdminController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/usuarios</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/usuarios/estado</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/usuarios/roles</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/auditoria</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/reportes</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/agente/reportes</url-pattern>
    </servlet-mapping>

    <!-- ===================================================== -->
    <!-- FILTRO: AutorizacionFilter                             -->
    <!-- Protege las rutas privadas segun sesion y rol          -->
    <!-- ===================================================== -->
    <filter>
        <filter-name>AutorizacionFilter</filter-name>
        <filter-class>filtro.AutorizacionFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/dashboard_cliente.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/citas_cliente.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/solicitudes_cliente.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/cita_form.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/solicitud_form.jsp</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/dashboard_agente.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/agente_propiedades.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/formulario_propiedad.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/citas_agente.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/solicitudes_agente.jsp</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/dashboard_admin.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/admin_usuarios.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/admin_reportes.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/admin_auditoria.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/cambiarModo.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/perfil.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/perfil</url-pattern>
    </filter-mapping>

    <!-- Control de acceso por prefijo en servlets y rutas estructuradas -->
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/agente/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AutorizacionFilter</filter-name>
        <url-pattern>/cliente/*</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/denegado.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/denegado.jsp</location>
    </error-page>

</web-app>
