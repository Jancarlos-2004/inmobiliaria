digraph MER {
  rankdir=LR; node [shape=box, style=rounded];
  usuarios -> perfiles [label="1:1"];
  usuarios -> propiedades [label="1:N agente"];
  ciudades -> propiedades [label="1:N"];
  tipos_propiedades -> propiedades [label="1:N"];
