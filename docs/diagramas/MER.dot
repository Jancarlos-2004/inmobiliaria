  usuarios -> citas [label="1:N cliente"]; propiedades -> citas [label="1:N"];
  usuarios -> solicitudes [label="1:N cliente"]; propiedades -> solicitudes [label="1:N"];
  solicitudes -> documentos_solicitudes [label="1:N"];
  usuarios -> favoritos [label="N:M"]; favoritos -> propiedades;
